---
import type { Lens } from '../lib/types';
import {
  focalLengthLabel,
  apertureLabel,
  weightLabel,
  weightBucketId,
  lensSearchText,
  specLabel,
  isFieldVerified,
  verifiedAttribute,
} from '../lib/lenses';
import { t, brandName, localeHref, type Lang } from '../lib/i18n';
import CompareToggleButton from './CompareToggleButton.astro';

interface Props {
  lenses: Lens[];
  lang: Lang;
}

const { lenses, lang } = Astro.props;
---
<div class="lens-table-wrap" id="lens-table-wrap">
  <table class="lens-table">
    <thead>
      <tr>
        <th>{t(lang, 'table.brand')}</th>
        <th>{t(lang, 'table.model')}</th>
        <th>{t(lang, 'table.alliance')}</th>
        <th>{t(lang, 'table.format')}</th>
        <th>{t(lang, 'table.type')}</th>
        <th>{t(lang, 'table.focus')}</th>
        <th>{t(lang, 'table.focalLength')}</th>
        <th>{t(lang, 'table.maxAperture')}</th>
        <th>{t(lang, 'table.weight')}</th>
        <th>{t(lang, 'table.year')}</th>
        <th>{t(lang, 'table.compare')}</th>
      </tr>
    </thead>
    <tbody>
      {lenses.map((lens) => (
        <tr
          data-lens-row
          data-lens-id={lens.id}
          data-brand={lens.brand}
          data-format={verifiedAttribute(lens, 'format')}
          data-focus-type={verifiedAttribute(lens, 'focusType')}
          data-lens-type={verifiedAttribute(lens, 'lensType')}
          data-alliance={isFieldVerified(lens, 'allianceMember') ? String(lens.allianceMember) : 'unconfirmed'}
          data-weight-bucket={isFieldVerified(lens, 'weightGram') ? weightBucketId(lens.weightGram) : undefined}
          data-weight={verifiedAttribute(lens, 'weightGram')}
          data-focal-min={verifiedAttribute(lens, 'focalLengthMin')}
          data-focal-max={verifiedAttribute(lens, 'focalLengthMax')}
          data-max-aperture={verifiedAttribute(lens, 'maxAperture')}
          data-release-year={verifiedAttribute(lens, 'releaseYear')}
          data-search={lensSearchText(lens)}
        >
          <td>{brandName(lang, lens.brand)}</td>
          <td><a href={localeHref(lang, `lenses/${lens.id}`)}>{lens.model}</a></td>
          <td>{specLabel(lens, 'allianceMember', lang)}</td>
          <td>{specLabel(lens, 'format', lang)}</td>
          <td>{specLabel(lens, 'lensType', lang)}</td>
          <td>{specLabel(lens, 'focusType', lang)}</td>
          <td>{focalLengthLabel(lens, lang)}</td>
          <td>{apertureLabel(lens, lang)}</td>
          <td>{weightLabel(lens, lang)}</td>
          <td>{specLabel(lens, 'releaseYear', lang)}</td>
          <td class="lens-table__compare-cell">
            <CompareToggleButton lens={lens} lang={lang} />
          </td>
        </tr>
      ))}
    </tbody>
  </table>
</div>
