---
import Layout from '../../../layouts/Layout.astro';
import {
  getAllLenses,
  getLensById,
  lensSeo,
  lensNotes,
  specLabel,
  isFieldVerified,
} from '../../../lib/lenses';
import { t, brandName, localeHref, localeStaticPaths, langFromParam } from '../../../lib/i18n';

// Every lens, once per locale.
export function getStaticPaths() {
  const lenses = getAllLenses();
  return localeStaticPaths().flatMap(({ params }) =>
    lenses.map((lens) => ({ params: { locale: params.locale, id: lens.id } }))
  );
}

const { locale, id } = Astro.params;
const lang = langFromParam(locale);
const lens = getLensById(id as string);

if (!lens) {
  throw new Error(`Lens not found: ${id}`);
}

const { title, description } = lensSeo(lens, lang);
const brand = brandName(lang, lens.brand);
const homeHref = localeHref(lang);
---
<Layout lang={lang} path={`lenses/${lens.id}`} title={title} description={description} noindex={!lens.verification?.mountConfirmed}>
  <a class="back-link" href={homeHref}>{t(lang, 'detail.back')}</a>

  <div class="detail-header">
    <div class="detail-header__brand">{brand}</div>
    <h1 class="detail-header__model">{lens.model}</h1>
    <div class="lens-card__badges">
      <span class={`badge ${!isFieldVerified(lens, 'allianceMember') ? 'badge--outline' : lens.allianceMember ? 'badge--alliance' : 'badge--third-party'}`}>
        {isFieldVerified(lens, 'allianceMember') ? t(lang, lens.allianceMember ? 'detail.allianceMember' : 'detail.thirdParty') : t(lang, 'spec.unconfirmed')}
      </span>
      <span class="badge badge--outline">
        {specLabel(lens, 'format', lang)}
      </span>
      <span class="badge badge--outline">
        {specLabel(lens, 'lensType', lang)}
      </span>
      <span class="badge badge--outline">
        {specLabel(lens, 'focusType', lang)}
      </span>
      {lens.category.map((cat) => <span class="badge badge--outline">{t(lang, `category.${cat}`)}</span>)}
    </div>
  </div>

  {isFieldVerified(lens, 'allianceMember') && !lens.allianceMember && (
    <div class="disclaimer-banner">
      <strong>{t(lang, 'detail.notAlliance')}</strong>{' '}
      <span>{brand}</span>{' '}
      <span>{t(lang, 'detail.notAllianceBody')}</span>
    </div>
  )}

  <div class="link-row">
    <a class="btn btn--primary" href={lens.officialUrl} target="_blank" rel="noopener noreferrer">
      {t(lang, 'detail.officialPage')}
    </a>
    {lens.affiliateUrls.map((r) => (
      <a class="btn" href={r.url} target="_blank" rel="noopener noreferrer nofollow sponsored">
        {r.label} {r.sponsored ? <span>{t(lang, 'detail.sponsored')}</span> : null}
      </a>
    ))}
  </div>

  <div class="disclaimer-banner" data-verification-status>
    <strong>{t(lang, 'audit.checked', { date: lens.verification?.checkedAt ?? '—' })}</strong>
    <p>{t(lang, lens.verification?.mountConfirmed ? 'audit.pending' : 'audit.mountPending')}</p>
    <a href={localeHref(lang, 'data-audit')}>{t(lang, 'audit.link')}</a>
  </div>
  <h2 class="section-title">{t(lang, 'detail.specifications')}</h2>
  <table class="spec-table"><tbody>
    <tr><th>{t(lang, 'spec.mount')}</th><td data-spec="mount">{specLabel(lens, 'mount', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.format')}</th><td data-spec="format">{specLabel(lens, 'format', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.lensType')}</th><td data-spec="lensType">{specLabel(lens, 'lensType', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.focusType')}</th><td data-spec="focusType">{specLabel(lens, 'focusType', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.focalLength')}</th><td data-spec="focalLengthMin">{specLabel(lens, 'focalLengthMin', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.maxAperture')}</th><td data-spec="maxAperture">{specLabel(lens, 'maxAperture', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.minAperture')}</th><td data-spec="minAperture">{specLabel(lens, 'minAperture', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.weight')}</th><td data-spec="weightGram">{specLabel(lens, 'weightGram', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.filterThread')}</th><td data-spec="filterThreadMm">{specLabel(lens, 'filterThreadMm', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.minFocusDistance')}</th><td data-spec="minFocusDistanceM">{specLabel(lens, 'minFocusDistanceM', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.maxMagnification')}</th><td data-spec="maxMagnification">{specLabel(lens, 'maxMagnification', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.stabilization')}</th><td data-spec="stabilization">{specLabel(lens, 'stabilization', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.weatherSealed')}</th><td data-spec="weatherSealed">{specLabel(lens, 'weatherSealed', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.releaseYear')}</th><td data-spec="releaseYear">{specLabel(lens, 'releaseYear', lang)}</td></tr>
    <tr><th>{t(lang, 'spec.allianceMember')}</th><td data-spec="allianceMember">{specLabel(lens, 'allianceMember', lang)}</td></tr>
  </tbody></table>
  <p>{t(lang, 'audit.yearMeaning')}</p>

  <h2 class="section-title">{t(lang, 'detail.notes')}</h2>
  <p>{lensNotes(lens, lang)}</p>

  <h2 class="section-title">{t(lang, 'detail.dataSources')}</h2>
  <ul>
    {lens.sourceUrls.map((url) => (
      <li><a href={url} target="_blank" rel="noopener noreferrer">{url}</a></li>
    ))}
  </ul>
  <p style="color:var(--color-text-muted); font-size:0.85rem;">{t(lang, 'detail.sourcesFooter')}</p>

  <a class="back-link" href={homeHref}>{t(lang, 'detail.back')}</a>
</Layout>
